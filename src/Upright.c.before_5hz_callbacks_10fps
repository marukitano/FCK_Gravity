#include <pebble.h>
#include "t2_vector_test.h"

#define SENSOR_RATE ACCEL_SAMPLING_10HZ
#define FRAME_INTERVAL_MS 40
#define REST_DEADZONE (TRIG_MAX_ANGLE / 90)
#define MOVING_DEADZONE (TRIG_MAX_ANGLE / 240)
#define DISPLAY_DEADZONE (TRIG_MAX_ANGLE / 720)
#define MOTION_HOLD_SAMPLES 4
#define START_MOTION_SAMPLES 1

static Window *s_window;
static Layer *s_canvas_layer;
static AppTimer *s_frame_timer;

static GPath *s_paths[T2_VECTOR_CONTOUR_COUNT];

static int32_t s_target_angle = TRIG_MAX_ANGLE / 4;
static int32_t s_display_angle = TRIG_MAX_ANGLE / 4;

static uint8_t s_motion_hold = 0;
static uint8_t s_motion_start_samples = 0;

static int32_t normalize_angle(int32_t angle) {
  while (angle < 0) {
    angle += TRIG_MAX_ANGLE;
  }

  while (angle >= TRIG_MAX_ANGLE) {
    angle -= TRIG_MAX_ANGLE;
  }

  return angle;
}

static int32_t shortest_angle_difference(int32_t from, int32_t to) {
  int32_t difference = to - from;
  const int32_t half_turn = TRIG_MAX_ANGLE / 2;

  if (difference > half_turn) {
    difference -= TRIG_MAX_ANGLE;
  } else if (difference < -half_turn) {
    difference += TRIG_MAX_ANGLE;
  }

  return difference;
}

static int32_t absolute_i32(int32_t value) {
  return value < 0 ? -value : value;
}

static void accel_data_handler(AccelData *data, uint32_t num_samples) {
  if (!data || num_samples == 0) {
    return;
  }

  const AccelData latest = data[num_samples - 1];

  if (latest.did_vibrate) {
    return;
  }

  const int32_t measured_angle =
      atan2_lookup(latest.y, latest.x);

  const int32_t difference =
      shortest_angle_difference(
          s_target_angle,
          measured_angle);

  const int32_t distance = absolute_i32(difference);

  /*
   * Im Stillstand muessen zwei aufeinanderfolgende Messungen
   * die groessere Totzone verlassen. Einzelne Sensor-Ausreisser
   * werden dadurch ignoriert.
   *
   * Sobald echte Bewegung erkannt wurde, bleibt der Filter fuer
   * einige Samples im Bewegungsmodus. Dort gilt nur eine kleine
   * Totzone und der Zielwinkel folgt sehr schnell.
   */
  if (s_motion_hold > 0) {
    if (distance > MOVING_DEADZONE) {
      s_target_angle =
          normalize_angle(
              s_target_angle + (difference * 2) / 3);
    }

    if (distance > REST_DEADZONE) {
      s_motion_hold = MOTION_HOLD_SAMPLES;
    } else {
      --s_motion_hold;
    }

    s_motion_start_samples = 0;
    return;
  }

  if (distance > REST_DEADZONE) {
    ++s_motion_start_samples;

    if (s_motion_start_samples >= START_MOTION_SAMPLES) {
      s_target_angle =
          normalize_angle(
              s_target_angle + (difference * 3) / 4);

      s_motion_hold = MOTION_HOLD_SAMPLES;
      s_motion_start_samples = 0;
    }
  } else {
    s_motion_start_samples = 0;
  }
}

static void frame_timer_handler(void *context) {
  (void)context;

  const int32_t difference =
      shortest_angle_difference(
          s_display_angle,
          s_target_angle);

  if (absolute_i32(difference) > DISPLAY_DEADZONE) {
    int32_t step = (difference * 9) / 20;

    if (step == 0) {
      step = difference > 0 ? 1 : -1;
    }

    s_display_angle =
        normalize_angle(s_display_angle + step);

    if (s_canvas_layer) {
      layer_mark_dirty(s_canvas_layer);
    }
  }

  s_frame_timer =
      app_timer_register(
          FRAME_INTERVAL_MS,
          frame_timer_handler,
          NULL);
}

static void canvas_update_proc(Layer *layer, GContext *ctx) {
  const GRect bounds = layer_get_bounds(layer);

  graphics_context_set_fill_color(ctx, GColorBlack);
  graphics_fill_rect(ctx, bounds, 0, GCornerNone);

  const int32_t rotation =
      normalize_angle(
          DEG_TO_TRIGANGLE(270) - s_display_angle);

  for (int i = 0; i < T2_VECTOR_CONTOUR_COUNT; ++i) {
    if (!s_paths[i]) {
      continue;
    }

    graphics_context_set_fill_color(
        ctx,
        T2_VECTOR_CONTOURS[i].is_hole
            ? GColorBlack
            : GColorWhite);

    gpath_rotate_to(s_paths[i], rotation);
    gpath_draw_filled(ctx, s_paths[i]);
  }
}

static bool create_paths(void) {
  for (int i = 0; i < T2_VECTOR_CONTOUR_COUNT; ++i) {
    s_paths[i] =
        gpath_create(&T2_VECTOR_CONTOURS[i].path_info);

    if (!s_paths[i]) {
      APP_LOG(
          APP_LOG_LEVEL_ERROR,
          "Could not create vector contour %d",
          i);
      return false;
    }

    gpath_move_to(
        s_paths[i],
        GPoint(T2_VECTOR_CENTER_X, T2_VECTOR_CENTER_Y));
  }

  return true;
}

static void destroy_paths(void) {
  for (int i = 0; i < T2_VECTOR_CONTOUR_COUNT; ++i) {
    if (s_paths[i]) {
      gpath_destroy(s_paths[i]);
      s_paths[i] = NULL;
    }
  }
}

static void init(void) {
  s_window = window_create();
  window_set_background_color(s_window, GColorBlack);

  Layer *root_layer = window_get_root_layer(s_window);

  s_canvas_layer =
      layer_create(layer_get_bounds(root_layer));

  layer_set_update_proc(
      s_canvas_layer,
      canvas_update_proc);

  layer_add_child(root_layer, s_canvas_layer);

  if (!create_paths()) {
    APP_LOG(
        APP_LOG_LEVEL_ERROR,
        "Vector path initialization failed");
  }

  accel_service_set_sampling_rate(SENSOR_RATE);
  accel_data_service_subscribe(1, accel_data_handler);

  s_frame_timer =
      app_timer_register(
          FRAME_INTERVAL_MS,
          frame_timer_handler,
          NULL);

  window_stack_push(s_window, true);
}

static void deinit(void) {
  if (s_frame_timer) {
    app_timer_cancel(s_frame_timer);
    s_frame_timer = NULL;
  }

  accel_data_service_unsubscribe();

  destroy_paths();

  if (s_canvas_layer) {
    layer_destroy(s_canvas_layer);
    s_canvas_layer = NULL;
  }

  if (s_window) {
    window_destroy(s_window);
    s_window = NULL;
  }
}

int main(void) {
  init();
  app_event_loop();
  deinit();
}
